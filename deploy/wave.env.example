APP_NAME=moziketo-wave
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=change-me-in-production-use-openssl-rand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_API_KEY=change-me-in-production

DATABASE_URL=postgresql+asyncpg://moziketo:moziketo@postgres:5432/moziketo
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120

# Fallback when track.audio_url is empty ({slug}.mp3). Imported WP tracks use Arvan S3 URLs from post meta.
MEDIA_BASE_URL=https://dl.moziketo.ir/music
WP_API_BASE_URL=https://moziketo.ir/wp-json

CORS_ORIGINS=https://pwa.moziketo.ir,https://moziketo.ir,http://localhost:3000

# Auth rate limits
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_WINDOW=900
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_EMAIL_WINDOW=900
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_IP_WINDOW=3600
AUTH_FORGOT_EMAIL_LIMIT=3
AUTH_FORGOT_EMAIL_WINDOW=3600
AUTH_FORGOT_IP_LIMIT=10
AUTH_FORGOT_IP_WINDOW=3600
PASSWORD_RESET_TTL_SECONDS=3600

# Email — wave sends to internal Postfix relay (see postfix.env)
EMAIL_ENABLED=true
SMTP_HOST=postfix
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@moziketo.ir
SMTP_USE_TLS=false
FRONTEND_VERIFY_URL=https://pwa.moziketo.ir/auth/verify-email
FRONTEND_RESET_URL=https://pwa.moziketo.ir/auth/reset-password
EMAIL_VERIFY_TTL_SECONDS=86400

# OAuth
OAUTH_FRONTEND_CALLBACK_URL=https://pwa.moziketo.ir/auth/callback
OAUTH_API_BASE_URL=https://api.moziketo.ir/api/v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

POSTGRES_USER=moziketo
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=moziketo

# Arvan S3 — admin uploads + user avatars
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=moziketo
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://moziketo.s3.ir-thr-at1.arvanstorage.ir
S3_UPLOAD_ACL=private
S3_PRESIGN_TTL_SECONDS=3600
UPLOAD_MAX_BYTES=10485760

PUBLIC_RATE_LIMIT_ENABLED=true
TASKIQ_INLINE=false

MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=change-me
MEILI_INDEX_PREFIX=moziketo
SEARCH_BACKEND=postgres

FRONTEND_CHANGE_EMAIL_URL=https://pwa.moziketo.ir/auth/change-email
EMAIL_CHANGE_TTL_SECONDS=86400
AUTH_CHANGE_EMAIL_LIMIT=3
AUTH_CHANGE_EMAIL_WINDOW=3600
AUTH_EXPORT_LIMIT=5
AUTH_EXPORT_WINDOW=3600
