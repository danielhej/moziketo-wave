APP_NAME=moziketo-wave
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=change-me-in-production-use-openssl-rand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_API_KEY=change-me-in-production

DATABASE_URL=postgresql+asyncpg://moziketo:moziketo@postgres:5432/moziketo
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120

# Fallback when track.audio_url is empty ({slug}.mp3). Imported WP tracks use Arvan S3 URLs from post meta.
MEDIA_BASE_URL=https://dl.moziketo.ir/music
WP_API_BASE_URL=https://moziketo.ir/wp-json

CORS_ORIGINS=https://pwa.moziketo.ir,https://moziketo.ir,http://localhost:3000

POSTGRES_USER=moziketo
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=moziketo
