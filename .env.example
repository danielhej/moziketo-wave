# Application
APP_NAME=moziketo-wave
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://moziketo:moziketo@localhost:5432/moziketo

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://moziketo.ir

# Media / S3 (optional for MVP)
S3_ENDPOINT=
S3_BUCKET=moziketo-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
