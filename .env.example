# Application
APP_NAME=moziketo-wave
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://moziketo:moziketo@localhost:5432/moziketo

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=120

# Media & ingest
MEDIA_BASE_URL=https://dl.moziketo.ir/music
DOWNLOADER_URL=http://130.185.120.239:8787
DOWNLOADER_SECRET=
WP_API_BASE_URL=https://moziketo.ir/wp-json

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://moziketo.ir,https://pwa.moziketo.ir

# Auth rate limits
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_WINDOW=900
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_EMAIL_WINDOW=900
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_IP_WINDOW=3600
AUTH_FORGOT_EMAIL_LIMIT=3
AUTH_FORGOT_EMAIL_WINDOW=3600
AUTH_FORGOT_IP_LIMIT=10
AUTH_FORGOT_IP_WINDOW=3600
PASSWORD_RESET_TTL_SECONDS=3600

# Email (SMTP) — leave disabled for dev token-only flows
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@moziketo.ir
SMTP_USE_TLS=true
FRONTEND_VERIFY_URL=http://localhost:3000/auth/verify-email
FRONTEND_RESET_URL=http://localhost:3000/auth/reset-password
EMAIL_VERIFY_TTL_SECONDS=86400

# OAuth (leave empty to disable provider)
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
OAUTH_API_BASE_URL=http://localhost:8000/api/v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple Sign In (disabled by default — set OAUTH_APPLE_ENABLED=true when configured)
OAUTH_APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Docker compose local
POSTGRES_USER=moziketo
POSTGRES_PASSWORD=moziketo
POSTGRES_DB=moziketo

# Object storage (Arvan S3) — required for uploads
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=moziketo
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://moziketo.s3.ir-thr-at1.arvanstorage.ir
S3_UPLOAD_ACL=private
S3_PRESIGN_TTL_SECONDS=3600
UPLOAD_MAX_BYTES=10485760

# Public API rate limits
PUBLIC_RATE_LIMIT_ENABLED=true

# Taskiq — set true in tests; worker container handles jobs in production
TASKIQ_INLINE=false

# Meilisearch (optional — SEARCH_BACKEND=postgres by default)
MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=
MEILI_INDEX_PREFIX=moziketo
SEARCH_BACKEND=postgres
